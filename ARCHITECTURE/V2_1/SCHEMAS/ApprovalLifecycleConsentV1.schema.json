{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ApprovalLifecycleConsentV1.schema.json",
  "title": "ApprovalLifecycleConsentV1",
  "description": "AA signs only after fresh validated WebAuthnCeremonyV1 using ApprovalLifecycleChallengeV1; digest references include exact action and independently enrolled current actor role. Count distinct actor_id, not keys, for dual quorum. Ordinary API cannot create receipt.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "ApprovalLifecycleConsentV1"
    },
    "wire_revision": {
      "const": 1
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "authority_epoch": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "action_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "challenge_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ceremony_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "actor_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "credential_binding_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "credential_generation": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "x-minimum": "0",
      "x-maximum": "18446744073709551615"
    },
    "purpose": {
      "enum": [
        "OWNER_CONSENT",
        "ADMIN_CONSENT",
        "SECURITY_SUSPEND"
      ],
      "x-cbor-enum-codes": {
        "OWNER_CONSENT": 0,
        "ADMIN_CONSENT": 1,
        "SECURITY_SUSPEND": 2
      }
    },
    "approval_authority_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "issued_at": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "x-minimum": "-9223372036854775808",
      "x-maximum": "9223372036854775807"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "x-minimum": "-9223372036854775808",
      "x-maximum": "9223372036854775807"
    }
  },
  "required": [
    "type",
    "wire_revision",
    "tenant_id",
    "authority_epoch",
    "action_digest",
    "challenge_digest",
    "ceremony_digest",
    "actor_id",
    "credential_binding_id",
    "credential_generation",
    "purpose",
    "approval_authority_id",
    "issued_at",
    "expires_at"
  ],
  "x-cbor-order": [
    "type",
    "wire_revision",
    "tenant_id",
    "authority_epoch",
    "action_digest",
    "challenge_digest",
    "ceremony_digest",
    "actor_id",
    "credential_binding_id",
    "credential_generation",
    "purpose",
    "approval_authority_id",
    "issued_at",
    "expires_at"
  ]
}
