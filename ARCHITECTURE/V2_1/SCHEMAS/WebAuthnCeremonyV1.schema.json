{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "WebAuthnCeremonyV1.schema.json",
  "title": "WebAuthnCeremonyV1",
  "description": "Exact received bytes, do not JSON reserialize before checking WebAuthn signature. Verify type webauthn.get, base64url challenge, exact origin/RP hash, UP/UV, credential key, flags/extension policy, session and unused challenge. ES256 DER signature follows WebAuthn, distinct from Ed25519 authority envelope.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "WebAuthnCeremonyV1"
    },
    "wire_revision": {
      "const": 1
    },
    "credential_id": {
      "type": "string",
      "pattern": "^([0-9a-f]{2})*$",
      "maxLength": 2097152
    },
    "client_data_json": {
      "type": "string",
      "pattern": "^([0-9a-f]{2})*$",
      "maxLength": 2097152
    },
    "authenticator_data": {
      "type": "string",
      "pattern": "^([0-9a-f]{2})*$",
      "maxLength": 2097152
    },
    "signature": {
      "type": "string",
      "pattern": "^([0-9a-f]{2})*$",
      "maxLength": 2097152
    },
    "challenge_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "received_at": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "x-minimum": "-9223372036854775808",
      "x-maximum": "9223372036854775807"
    }
  },
  "required": [
    "type",
    "wire_revision",
    "credential_id",
    "client_data_json",
    "authenticator_data",
    "signature",
    "challenge_digest",
    "received_at"
  ],
  "x-cbor-order": [
    "type",
    "wire_revision",
    "credential_id",
    "client_data_json",
    "authenticator_data",
    "signature",
    "challenge_digest",
    "received_at"
  ]
}
