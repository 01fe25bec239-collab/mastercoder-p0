{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ProducerEventV2.schema.json",
  "title": "ProducerEventV2",
  "description": "Non-attempt authoritative events require specific authorized producer role; ordinary API cannot publish trust/epoch/policy changes merely by using this envelope.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "ProducerEventV2"
    },
    "wire_revision": {
      "const": 1
    },
    "scope": {
      "$ref": "ScopeV1.schema.json"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "producer_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "producer_session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "producer_generation": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "x-minimum": "0",
      "x-maximum": "18446744073709551615"
    },
    "sequence": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "x-minimum": "0",
      "x-maximum": "18446744073709551615"
    },
    "occurred_at": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "x-minimum": "-9223372036854775808",
      "x-maximum": "9223372036854775807"
    },
    "received_at": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "x-minimum": "-9223372036854775808",
      "x-maximum": "9223372036854775807"
    },
    "payload_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+ -]*$"
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "type",
    "wire_revision",
    "scope",
    "event_id",
    "producer_id",
    "producer_session_id",
    "producer_generation",
    "sequence",
    "occurred_at",
    "received_at",
    "payload_type",
    "payload_digest"
  ],
  "x-cbor-order": [
    "type",
    "wire_revision",
    "scope",
    "event_id",
    "producer_id",
    "producer_session_id",
    "producer_generation",
    "sequence",
    "occurred_at",
    "received_at",
    "payload_type",
    "payload_digest"
  ]
}
