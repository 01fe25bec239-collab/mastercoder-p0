{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "FindingCandidateV2.schema.json",
  "title": "FindingCandidateV2",
  "description": "Untrusted claim until evidence authority acceptance. No provider/gate privilege.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "FindingCandidateV2"
    },
    "wire_revision": {
      "const": 1
    },
    "scope": {
      "$ref": "ScopeV1.schema.json"
    },
    "finding_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "attempt_binding_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "unit_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+ -]*$"
    },
    "claim_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "oracle": {
      "$ref": "OracleTrustClassV1.schema.json"
    },
    "evidence_digests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "maxItems": 65536,
      "uniqueItems": true,
      "x-order": "lexicographic canonical encoded element bytes"
    },
    "producer_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "x-minimum": "-9223372036854775808",
      "x-maximum": "9223372036854775807"
    }
  },
  "required": [
    "type",
    "wire_revision",
    "scope",
    "finding_id",
    "attempt_binding_digest",
    "unit_id",
    "claim_digest",
    "oracle",
    "evidence_digests",
    "producer_id",
    "created_at"
  ],
  "x-cbor-order": [
    "type",
    "wire_revision",
    "scope",
    "finding_id",
    "attempt_binding_digest",
    "unit_id",
    "claim_digest",
    "oracle",
    "evidence_digests",
    "producer_id",
    "created_at"
  ]
}
