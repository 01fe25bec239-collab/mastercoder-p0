{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "HumanApprovalAssertionV2.schema.json",
  "title": "HumanApprovalAssertionV2",
  "description": "Detached Approval Authority signature after fresh direct UV. Gateway resolves current binding/generation, revocation, scope, custody and exact plan before each effect STARTED; assertion expiry cannot authorize a whole future sequence.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "HumanApprovalAssertionV2"
    },
    "wire_revision": {
      "const": 1
    },
    "scope": {
      "$ref": "ScopeV1.schema.json"
    },
    "approval_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "publication_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "custody_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verification_set_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_tree": {
      "$ref": "GitOidV1.schema.json"
    },
    "destination_ref": {
      "type": "string",
      "minLength": 12,
      "maxLength": 1024,
      "pattern": "^refs/heads/[^ ~^:?*\\\\\\[\\x00-\\x20]+$"
    },
    "effects_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "user_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "credential_binding_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "credential_generation": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "x-minimum": "0",
      "x-maximum": "18446744073709551615"
    },
    "display_receipt_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "challenge_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "challenge_nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ceremony_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "approval_authority_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "approval_authority_generation": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "x-minimum": "0",
      "x-maximum": "18446744073709551615"
    },
    "issued_at": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "x-minimum": "-9223372036854775808",
      "x-maximum": "9223372036854775807"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "x-minimum": "-9223372036854775808",
      "x-maximum": "9223372036854775807"
    }
  },
  "required": [
    "type",
    "wire_revision",
    "scope",
    "approval_id",
    "publication_id",
    "plan_digest",
    "custody_digest",
    "verification_set_digest",
    "policy_digest",
    "candidate_tree",
    "destination_ref",
    "effects_digest",
    "user_id",
    "credential_binding_id",
    "credential_generation",
    "display_receipt_digest",
    "challenge_digest",
    "challenge_nonce",
    "ceremony_digest",
    "approval_authority_id",
    "approval_authority_generation",
    "issued_at",
    "expires_at"
  ],
  "x-cbor-order": [
    "type",
    "wire_revision",
    "scope",
    "approval_id",
    "publication_id",
    "plan_digest",
    "custody_digest",
    "verification_set_digest",
    "policy_digest",
    "candidate_tree",
    "destination_ref",
    "effects_digest",
    "user_id",
    "credential_binding_id",
    "credential_generation",
    "display_receipt_digest",
    "challenge_digest",
    "challenge_nonce",
    "ceremony_digest",
    "approval_authority_id",
    "approval_authority_generation",
    "issued_at",
    "expires_at"
  ]
}
