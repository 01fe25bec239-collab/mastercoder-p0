{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "WorkflowSpecCoreV2.schema.json",
  "title": "WorkflowSpecCoreV2",
  "description": "No attempt digest here: immutable workflow is hashed before attempt allocation; no cyclic binding.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "WorkflowSpecCoreV2"
    },
    "wire_revision": {
      "const": 1
    },
    "scope": {
      "$ref": "ScopeV1.schema.json"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "subject_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "analysis_plan_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capability_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "resource_envelope_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mode": {
      "enum": [
        "FAST",
        "AI",
        "HYBRID",
        "DEEP"
      ],
      "x-cbor-enum-codes": {
        "FAST": 0,
        "AI": 1,
        "HYBRID": 2,
        "DEEP": 3
      }
    },
    "required_unit_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+ -]*$"
      },
      "maxItems": 65536,
      "uniqueItems": true,
      "x-order": "lexicographic canonical encoded element bytes"
    },
    "created_at": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "x-minimum": "-9223372036854775808",
      "x-maximum": "9223372036854775807"
    }
  },
  "required": [
    "type",
    "wire_revision",
    "scope",
    "workflow_id",
    "subject_digest",
    "policy_digest",
    "analysis_plan_digest",
    "capability_digest",
    "resource_envelope_digest",
    "mode",
    "required_unit_ids",
    "created_at"
  ],
  "x-cbor-order": [
    "type",
    "wire_revision",
    "scope",
    "workflow_id",
    "subject_digest",
    "policy_digest",
    "analysis_plan_digest",
    "capability_digest",
    "resource_envelope_digest",
    "mode",
    "required_unit_ids",
    "created_at"
  ]
}
