{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RevocationRecordV1.schema.json",
  "title": "RevocationRecordV1",
  "description": "Immutable and monotonic. Restore may not lower effective generation; journal EPOCH_FENCE records protect recovery.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "RevocationRecordV1"
    },
    "wire_revision": {
      "const": 1
    },
    "scope": {
      "$ref": "ScopeV1.schema.json"
    },
    "revocation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "subject_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revoked_generation": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "x-minimum": "0",
      "x-maximum": "18446744073709551615"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+ -]*$"
    },
    "effective_at": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "x-minimum": "-9223372036854775808",
      "x-maximum": "9223372036854775807"
    },
    "authority_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "subject_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+ -]*$"
    }
  },
  "required": [
    "type",
    "wire_revision",
    "scope",
    "revocation_id",
    "subject_digest",
    "revoked_generation",
    "reason",
    "effective_at",
    "authority_id",
    "subject_type"
  ],
  "x-cbor-order": [
    "type",
    "wire_revision",
    "scope",
    "revocation_id",
    "subject_digest",
    "revoked_generation",
    "reason",
    "effective_at",
    "authority_id",
    "subject_type"
  ]
}
