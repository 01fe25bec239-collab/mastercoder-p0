{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ResourceEnvelopeV2.schema.json",
  "title": "ResourceEnvelopeV2",
  "description": "Every descendant charges one protected root ledger; reservations serializable, no child budget creation. Native hidden-agent mode limited by measured outer envelope, no claimed internal accounting.",
  "type": "object",
  "additionalProperties": false,
