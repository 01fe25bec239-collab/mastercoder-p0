      "x-minimum": "0",
      "x-maximum": "18446744073709551615"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "maximum_nodes": {
      "type": "integer",
      "minimum": 0,
