{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AuditEnvelopeV1.schema.json",
  "title": "AuditEnvelopeV1",
  "description": "Metadata only, no raw source, secrets, free-form reason text, prompt, patch or request/response bodies. Subject digest points to protected authorized record. Immutable hash chain plus external seals; seal delay does not confer authority.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "AuditEnvelopeV1"
    },
    "wire_revision": {
      "const": 1
    },
    "scope": {
      "$ref": "ScopeV1.schema.json"
    },
    "audit_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "stream_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sequence": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "x-minimum": "0",
      "x-maximum": "18446744073709551615"
    },
    "previous_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "producer_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "producer_generation": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "x-minimum": "0",
      "x-maximum": "18446744073709551615"
    },
    "event_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+ -]*$"
    },
    "subject_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "outcome": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+ -]*$"
    },
    "recorded_at": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "x-minimum": "-9223372036854775808",
      "x-maximum": "9223372036854775807"
    },
    "subject_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+ -]*$"
    }
  },
  "required": [
    "type",
    "wire_revision",
    "scope",
    "audit_id",
    "stream_id",
    "sequence",
    "previous_digest",
    "producer_id",
    "producer_generation",
    "event_type",
    "subject_digest",
    "outcome",
    "recorded_at",
    "subject_type"
  ],
  "x-cbor-order": [
    "type",
    "wire_revision",
    "scope",
    "audit_id",
    "stream_id",
    "sequence",
    "previous_digest",
    "producer_id",
    "producer_generation",
    "event_type",
    "subject_digest",
    "outcome",
    "recorded_at",
    "subject_type"
  ]
}
