{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ResolutionChallengeV1.schema.json",
  "title": "ResolutionChallengeV1",
  "description": "Five-minute challenge from trusted resolution origin; exact action, active independently scoped resolver credential and UV required. Ceremony challenge bytes D(ResolutionChallengeV1,challenge), verified analogous to approval; resolution authority signs final envelope only after action commit.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "ResolutionChallengeV1"
    },
    "wire_revision": {
      "const": 1
    },
    "scope": {
      "$ref": "ScopeV1.schema.json"
    },
    "challenge_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "action_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "user_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "credential_binding_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "credential_generation": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "x-minimum": "0",
      "x-maximum": "18446744073709551615"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "issued_at": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "x-minimum": "-9223372036854775808",
      "x-maximum": "9223372036854775807"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "x-minimum": "-9223372036854775808",
      "x-maximum": "9223372036854775807"
    }
  },
  "required": [
    "type",
    "wire_revision",
    "scope",
    "challenge_id",
    "action_digest",
    "user_id",
    "credential_binding_id",
    "credential_generation",
    "session_id",
    "nonce",
    "issued_at",
    "expires_at"
  ],
  "x-cbor-order": [
    "type",
    "wire_revision",
    "scope",
    "challenge_id",
    "action_digest",
    "user_id",
    "credential_binding_id",
    "credential_generation",
    "session_id",
    "nonce",
    "issued_at",
    "expires_at"
  ]
}
