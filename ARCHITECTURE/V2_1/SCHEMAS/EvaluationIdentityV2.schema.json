{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "EvaluationIdentityV2.schema.json",
  "title": "EvaluationIdentityV2",
  "description": "Identity is not a mutable verdict or current pointer; supersession creates new identity and projection generation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "EvaluationIdentityV2"
    },
    "wire_revision": {
      "const": 1
    },
    "scope": {
      "$ref": "ScopeV1.schema.json"
    },
    "evaluation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "evaluation_sequence": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "x-minimum": "0",
      "x-maximum": "18446744073709551615"
    },
    "subject_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capability_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "trust_set_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verification_set_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "type",
    "wire_revision",
    "scope",
    "evaluation_id",
    "evaluation_sequence",
    "subject_digest",
    "policy_digest",
    "capability_digest",
    "trust_set_digest",
    "manifest_digest",
    "verification_set_digest"
  ],
  "x-cbor-order": [
    "type",
    "wire_revision",
    "scope",
    "evaluation_id",
    "evaluation_sequence",
    "subject_digest",
    "policy_digest",
    "capability_digest",
    "trust_set_digest",
    "manifest_digest",
    "verification_set_digest"
  ]
}
