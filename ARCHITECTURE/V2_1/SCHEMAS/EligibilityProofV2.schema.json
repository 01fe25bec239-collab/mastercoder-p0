{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "EligibilityProofV2.schema.json",
  "title": "EligibilityProofV2",
  "description": "Stable PR opener and current role/membership read-back required; commit author strings and stale cached membership do not grant eligibility.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "EligibilityProofV2"
    },
    "wire_revision": {
      "const": 1
    },
    "scope": {
      "$ref": "ScopeV1.schema.json"
    },
    "proof_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "provider": {
      "enum": [
        "GITHUB",
        "OTHER"
      ]
    },
    "installation_id": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "x-minimum": "0",
      "x-maximum": "18446744073709551615"
    },
    "pr_number": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "x-minimum": "0",
      "x-maximum": "18446744073709551615"
    },
    "provider_actor_id": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "x-minimum": "0",
      "x-maximum": "18446744073709551615"
    },
    "linked_user_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "membership_generation": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "x-minimum": "0",
      "x-maximum": "18446744073709551615"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "observation_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "issuer_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "issued_at": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "x-minimum": "-9223372036854775808",
      "x-maximum": "9223372036854775807"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "x-minimum": "-9223372036854775808",
      "x-maximum": "9223372036854775807"
    },
    "eligible": {
      "type": "boolean"
    }
  },
  "required": [
    "type",
    "wire_revision",
    "scope",
    "proof_id",
    "provider",
    "installation_id",
    "pr_number",
    "provider_actor_id",
    "linked_user_id",
    "membership_generation",
    "policy_digest",
    "observation_digest",
    "issuer_id",
    "issued_at",
    "expires_at",
    "eligible"
  ],
  "x-cbor-order": [
    "type",
    "wire_revision",
    "scope",
    "proof_id",
    "provider",
    "installation_id",
    "pr_number",
    "provider_actor_id",
    "linked_user_id",
    "membership_generation",
    "policy_digest",
    "observation_digest",
    "issuer_id",
    "issued_at",
    "expires_at",
    "eligible"
  ]
}
