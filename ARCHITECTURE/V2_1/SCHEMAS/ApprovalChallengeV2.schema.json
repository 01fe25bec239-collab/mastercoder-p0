{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ApprovalChallengeV2.schema.json",
  "title": "ApprovalChallengeV2",
  "description": "WebAuthn challenge = SHA256(domain-separated canonical challenge record), served only directly by approval origin. Nonce consumed once in same transaction as assertion creation; no challenge reuse.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "ApprovalChallengeV2"
    },
    "wire_revision": {
      "const": 1
    },
    "scope": {
      "$ref": "ScopeV1.schema.json"
    },
    "challenge_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "display_receipt_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "credential_binding_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "credential_generation": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "x-minimum": "0",
      "x-maximum": "18446744073709551615"
    },
    "user_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "issued_at": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "x-minimum": "-9223372036854775808",
      "x-maximum": "9223372036854775807"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "x-minimum": "-9223372036854775808",
      "x-maximum": "9223372036854775807"
    }
  },
  "required": [
    "type",
    "wire_revision",
    "scope",
    "challenge_id",
    "plan_digest",
    "display_receipt_digest",
    "credential_binding_id",
    "credential_generation",
    "user_id",
    "session_id",
    "nonce",
    "issued_at",
    "expires_at"
  ],
  "x-cbor-order": [
    "type",
    "wire_revision",
    "scope",
    "challenge_id",
    "plan_digest",
    "display_receipt_digest",
    "credential_binding_id",
    "credential_generation",
    "user_id",
    "session_id",
    "nonce",
    "issued_at",
    "expires_at"
  ]
}
