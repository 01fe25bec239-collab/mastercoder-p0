{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "DbStartCertificateV1.schema.json",
  "title": "DbStartCertificateV1",
  "description": "Protected effect authority signs only after committed STARTED transition with all current/expiry predicates. A DB timestamp is not proof by itself; journal validates authenticated certificate and current epoch fence.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "DbStartCertificateV1"
    },
    "wire_revision": {
      "const": 1
    },
    "scope": {
      "$ref": "ScopeV1.schema.json"
    },
    "effect_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "intent_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state_revision": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "x-minimum": "0",
      "x-maximum": "18446744073709551615"
    },
    "dispatcher_session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "committed_at": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "x-minimum": "-9223372036854775808",
      "x-maximum": "9223372036854775807"
    },
    "dispatch_deadline": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "x-minimum": "-9223372036854775808",
      "x-maximum": "9223372036854775807"
    },
    "request_deadline": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "x-minimum": "-9223372036854775808",
      "x-maximum": "9223372036854775807"
    },
    "authorization_snapshot_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "type",
    "wire_revision",
    "scope",
    "effect_id",
    "intent_digest",
    "state_revision",
    "dispatcher_session_id",
    "committed_at",
    "dispatch_deadline",
    "request_deadline",
    "authorization_snapshot_digest"
  ],
  "x-cbor-order": [
    "type",
    "wire_revision",
    "scope",
    "effect_id",
    "intent_digest",
    "state_revision",
    "dispatcher_session_id",
    "committed_at",
    "dispatch_deadline",
    "request_deadline",
    "authorization_snapshot_digest"
  ]
}
