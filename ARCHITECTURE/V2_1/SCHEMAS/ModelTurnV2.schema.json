{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ModelTurnV2.schema.json",
  "title": "ModelTurnV2",
  "description": "Ordered messages; tool IDs unique. No credentials, arbitrary headers or destination URL. Provider adapter maps only approved profile and rejects unsupported parameter/tool semantics.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "ModelTurnV2"
    },
    "wire_revision": {
      "const": 1
    },
    "scope": {
      "$ref": "ScopeV1.schema.json"
    },
    "turn_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "attempt_binding_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model_intent_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "model_cell_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "ModelMessageV1.schema.json"
      },
      "maxItems": 65536
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "ModelToolV1.schema.json"
      },
      "maxItems": 65536,
      "uniqueItems": true,
      "x-order": "lexicographic canonical encoded element bytes"
    },
    "maximum_output_tokens": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "x-minimum": "0",
      "x-maximum": "18446744073709551615"
    },
    "sampling_parameters_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "deadline": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "x-minimum": "-9223372036854775808",
      "x-maximum": "9223372036854775807"
    }
  },
  "required": [
    "type",
    "wire_revision",
    "scope",
    "turn_id",
    "attempt_binding_digest",
    "model_intent_id",
    "model_cell_digest",
    "messages",
    "tools",
    "maximum_output_tokens",
    "sampling_parameters_digest",
    "deadline"
  ],
  "x-cbor-order": [
    "type",
    "wire_revision",
    "scope",
    "turn_id",
    "attempt_binding_digest",
    "model_intent_id",
    "model_cell_digest",
    "messages",
    "tools",
    "maximum_output_tokens",
    "sampling_parameters_digest",
    "deadline"
  ]
}
