{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ApprovalCredentialBindingV1.schema.json",
  "title": "ApprovalCredentialBindingV1",
  "description": "Scope repository_id=0 only for tenant enrollment; authorization_scope explicitly names allowed repositories and is evaluated against publication scope. ES256 COSE key must be valid canonical WebAuthn key; only -7/P-256 accepted initially. Ordinary OIDC recovery cannot mint/change this binding.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "ApprovalCredentialBindingV1"
    },
    "wire_revision": {
      "const": 1
    },
    "scope": {
      "$ref": "ScopeV1.schema.json"
    },
    "binding_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "user_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "credential_id": {
      "type": "string",
      "pattern": "^([0-9a-f]{2})*$",
      "maxLength": 2097152
    },
    "public_key_cose": {
      "type": "string",
      "pattern": "^([0-9a-f]{2})*$",
      "maxLength": 2097152
    },
    "rp_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9.-]+$"
    },
    "allowed_origin": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^https://[a-z0-9.-]+(:[0-9]+)?$"
    },
    "authorization_scope_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "registration_ceremony_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "registration_authority_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "x-minimum": "-9223372036854775808",
      "x-maximum": "9223372036854775807"
    },
    "state": {
      "enum": [
        "ACTIVE",
        "SUSPENDED",
        "REVOKED"
      ],
      "x-cbor-enum-codes": {
        "ACTIVE": 0,
        "SUSPENDED": 1,
        "REVOKED": 2
      }
    },
    "credential_generation": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "x-minimum": "0",
      "x-maximum": "18446744073709551615"
    },
    "recovery_lineage": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "maxItems": 65536
    },
    "audit_record_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  },
  "required": [
    "type",
    "wire_revision",
    "scope",
    "binding_id",
    "user_id",
    "credential_id",
    "public_key_cose",
    "rp_id",
    "allowed_origin",
    "authorization_scope_digest",
    "registration_ceremony_digest",
    "registration_authority_id",
    "created_at",
    "state",
    "credential_generation",
    "recovery_lineage",
    "audit_record_id"
  ],
  "x-cbor-order": [
    "type",
    "wire_revision",
    "scope",
    "binding_id",
    "user_id",
    "credential_id",
    "public_key_cose",
    "rp_id",
    "allowed_origin",
    "authorization_scope_digest",
    "registration_ceremony_digest",
    "registration_authority_id",
    "created_at",
    "state",
    "credential_generation",
    "recovery_lineage",
    "audit_record_id"
  ]
}
