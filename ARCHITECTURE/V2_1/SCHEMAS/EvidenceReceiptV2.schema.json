{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "EvidenceReceiptV2.schema.json",
  "title": "EvidenceReceiptV2",
  "description": "Receipt signature establishes provenance; accepted evidence requires evidence authority and current trust. E3 requires valid oracle in addition to base-pass/candidate-fail.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "EvidenceReceiptV2"
    },
    "wire_revision": {
      "const": 1
    },
    "scope": {
      "$ref": "ScopeV1.schema.json"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "attempt_binding_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "unit_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+ -]*$"
    },
    "producer_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "producer_generation": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "x-minimum": "0",
      "x-maximum": "18446744073709551615"
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "environment_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "output_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "oracle": {
      "$ref": "OracleTrustClassV1.schema.json"
    },
    "grade": {
      "enum": [
        "E0",
        "E1",
        "E2",
        "E3",
        "E4"
      ],
      "x-cbor-enum-codes": {
        "E0": 0,
        "E1": 1,
        "E2": 2,
        "E3": 3,
        "E4": 4
      }
    },
    "created_at": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "x-minimum": "-9223372036854775808",
      "x-maximum": "9223372036854775807"
    }
  },
  "required": [
    "type",
    "wire_revision",
    "scope",
    "receipt_id",
    "attempt_binding_digest",
    "manifest_digest",
    "unit_id",
    "producer_id",
    "producer_generation",
    "input_digest",
    "environment_digest",
    "output_digest",
    "oracle",
    "grade",
    "created_at"
  ],
  "x-cbor-order": [
    "type",
    "wire_revision",
    "scope",
    "receipt_id",
    "attempt_binding_digest",
    "manifest_digest",
    "unit_id",
    "producer_id",
    "producer_generation",
    "input_digest",
    "environment_digest",
    "output_digest",
    "oracle",
    "grade",
    "created_at"
  ]
}
