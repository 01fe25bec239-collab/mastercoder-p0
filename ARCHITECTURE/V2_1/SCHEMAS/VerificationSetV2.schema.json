{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "VerificationSetV2.schema.json",
  "title": "VerificationSetV2",
  "description": "Immutable set, recomputed digest; every receipt signature, applicability, class, epoch and component revocation verified by Gate Authority.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "VerificationSetV2"
    },
    "wire_revision": {
      "const": 1
    },
    "scope": {
      "$ref": "ScopeV1.schema.json"
    },
    "verification_set_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "attempt_binding_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "subject_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "trust_set_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "receipt_digests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "maxItems": 65536,
      "uniqueItems": true,
      "x-order": "lexicographic canonical encoded element bytes"
    },
    "issuer_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "issued_at": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "x-minimum": "-9223372036854775808",
      "x-maximum": "9223372036854775807"
    }
  },
  "required": [
    "type",
    "wire_revision",
    "scope",
    "verification_set_id",
    "attempt_binding_digest",
    "subject_digest",
    "policy_digest",
    "trust_set_digest",
    "receipt_digests",
    "issuer_id",
    "issued_at"
  ],
  "x-cbor-order": [
    "type",
    "wire_revision",
    "scope",
    "verification_set_id",
    "attempt_binding_digest",
    "subject_digest",
    "policy_digest",
    "trust_set_digest",
    "receipt_digests",
    "issuer_id",
    "issued_at"
  ]
}
