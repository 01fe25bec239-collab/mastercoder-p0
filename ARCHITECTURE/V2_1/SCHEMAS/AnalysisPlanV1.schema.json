{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AnalysisPlanV1.schema.json",
  "title": "AnalysisPlanV1",
  "description": "Logical required work sealed before allocation, no attempt/manifest/workflow digest. Manifest after allocation copies exact units and subject/policy from plan; repository config cannot weaken required work.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "AnalysisPlanV1"
    },
    "wire_revision": {
      "const": 1
    },
    "scope": {
      "$ref": "ScopeV1.schema.json"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "subject_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capability_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "required_units": {
      "type": "array",
      "items": {
        "$ref": "AnalysisUnitV1.schema.json"
      },
      "maxItems": 65536,
      "uniqueItems": true,
      "x-order": "lexicographic canonical encoded element bytes"
    },
    "planner_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "x-minimum": "-9223372036854775808",
      "x-maximum": "9223372036854775807"
    }
  },
  "required": [
    "type",
    "wire_revision",
    "scope",
    "plan_id",
    "subject_digest",
    "policy_digest",
    "capability_digest",
    "required_units",
    "planner_id",
    "created_at"
  ],
  "x-cbor-order": [
    "type",
    "wire_revision",
    "scope",
    "plan_id",
    "subject_digest",
    "policy_digest",
    "capability_digest",
    "required_units",
    "planner_id",
    "created_at"
  ]
}
