{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ScopeV1.schema.json",
  "title": "ScopeV1",
  "description": "All values are authenticated by the receiving authority; repository ID is the stable GitHub numeric ID, never owner/name. Epochs must match current authority.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "ScopeV1"
    },
    "wire_revision": {
      "const": 1
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "repository_id": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "x-minimum": "0",
      "x-maximum": "18446744073709551615"
    },
    "repository_tenant_epoch": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "x-minimum": "0",
      "x-maximum": "18446744073709551615"
    },
    "authority_epoch": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  },
  "required": [
    "type",
    "wire_revision",
    "tenant_id",
    "repository_id",
    "repository_tenant_epoch",
    "authority_epoch"
  ],
  "x-cbor-order": [
    "type",
    "wire_revision",
    "tenant_id",
    "repository_id",
    "repository_tenant_epoch",
    "authority_epoch"
  ]
}
