{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ModelIntentV2.schema.json",
  "title": "ModelIntentV2",
  "description": "One use, budget consumed atomically under live lease before each call; actual spend settles even after lease loss. Currency is pinned in root resource envelope.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "ModelIntentV2"
    },
    "wire_revision": {
      "const": 1
    },
    "scope": {
      "$ref": "ScopeV1.schema.json"
    },
    "intent_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "attempt_binding_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "root_envelope_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "turn_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "model_cell_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "maximum_input_tokens": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "x-minimum": "0",
      "x-maximum": "18446744073709551615"
    },
    "maximum_output_tokens": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "x-minimum": "0",
      "x-maximum": "18446744073709551615"
    },
    "maximum_spend_microunits": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "x-minimum": "0",
      "x-maximum": "18446744073709551615"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "broker_generation": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "x-minimum": "0",
      "x-maximum": "18446744073709551615"
    },
    "deadline": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "x-minimum": "-9223372036854775808",
      "x-maximum": "9223372036854775807"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "type",
    "wire_revision",
    "scope",
    "intent_id",
    "attempt_binding_digest",
    "root_envelope_digest",
    "turn_id",
    "model_cell_digest",
    "maximum_input_tokens",
    "maximum_output_tokens",
    "maximum_spend_microunits",
    "request_digest",
    "broker_generation",
    "deadline",
    "nonce"
  ],
  "x-cbor-order": [
    "type",
    "wire_revision",
    "scope",
    "intent_id",
    "attempt_binding_digest",
    "root_envelope_digest",
    "turn_id",
    "model_cell_digest",
    "maximum_input_tokens",
    "maximum_output_tokens",
    "maximum_spend_microunits",
    "request_digest",
    "broker_generation",
    "deadline",
    "nonce"
  ]
}
