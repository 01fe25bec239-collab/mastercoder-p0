{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TrustBundleV1.schema.json",
  "title": "TrustBundleV1",
  "description": "Trust Authority verifies administrative domain registration outside ordinary API. Revocation checked online, never only via cached bundle expiry.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "TrustBundleV1"
    },
    "wire_revision": {
      "const": 1
    },
    "scope": {
      "$ref": "ScopeV1.schema.json"
    },
    "trust_bundle_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "generation": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "x-minimum": "0",
      "x-maximum": "18446744073709551615"
    },
    "members": {
      "type": "array",
      "items": {
        "$ref": "TrustMemberV1.schema.json"
      },
      "maxItems": 65536,
      "uniqueItems": true,
      "x-order": "lexicographic canonical encoded element bytes"
    },
    "created_at": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "x-minimum": "-9223372036854775808",
      "x-maximum": "9223372036854775807"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "x-minimum": "-9223372036854775808",
      "x-maximum": "9223372036854775807"
    }
  },
  "required": [
    "type",
    "wire_revision",
    "scope",
    "trust_bundle_id",
    "generation",
    "members",
    "created_at",
    "expires_at"
  ],
  "x-cbor-order": [
    "type",
    "wire_revision",
    "scope",
    "trust_bundle_id",
    "generation",
    "members",
    "created_at",
    "expires_at"
  ]
}
