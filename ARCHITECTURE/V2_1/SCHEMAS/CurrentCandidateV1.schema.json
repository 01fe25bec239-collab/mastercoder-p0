{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CurrentCandidateV1.schema.json",
  "title": "CurrentCandidateV1",
  "description": "Only protected provider-read authority writes. Webhooks trigger read-back; raw webhook data cannot advance truth.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "CurrentCandidateV1"
    },
    "wire_revision": {
      "const": 1
    },
    "scope": {
      "$ref": "ScopeV1.schema.json"
    },
    "subject_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provider_generation": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "x-minimum": "0",
      "x-maximum": "18446744073709551615"
    },
    "observation_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "writer_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "observed_at": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "x-minimum": "-9223372036854775808",
      "x-maximum": "9223372036854775807"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "x-minimum": "-9223372036854775808",
      "x-maximum": "9223372036854775807"
    }
  },
  "required": [
    "type",
    "wire_revision",
    "scope",
    "subject_digest",
    "provider_generation",
    "observation_digest",
    "writer_id",
    "observed_at",
    "expires_at"
  ],
  "x-cbor-order": [
    "type",
    "wire_revision",
    "scope",
    "subject_digest",
    "provider_generation",
    "observation_digest",
    "writer_id",
    "observed_at",
    "expires_at"
  ]
}
