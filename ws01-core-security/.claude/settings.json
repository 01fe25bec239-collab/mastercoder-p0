{
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)",
      "Bash(docker compose down:*)",
      "Bash(docker-compose down:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git branch -D:*)",
      "Bash(git worktree remove --force:*)",
      "Bash(git push --force:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo delete:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Read(**/.env)",
      "Read(**/.env.local)"
    ],
    "allow": [
      "Bash(git worktree list:*)",
      "Bash(git worktree prune:*)",
      "Bash(git worktree remove:*)",
      "Bash(git branch -d:*)",
      "Bash(sccache --show-stats:*)"
    ],
    "ask": [
      "Bash(git commit --amend:*)",
      "Bash(git stash:*)",
      "Bash(docker system prune:*)",
      "Bash(docker compose down -v:*)",
      "Bash(cargo add:*)",
      "Bash(cargo update:*)",
      "Bash(pnpm add:*)",
      "Bash(npm install:*)",
      "Bash(gh pr create:*)"
    ]
  }
}
