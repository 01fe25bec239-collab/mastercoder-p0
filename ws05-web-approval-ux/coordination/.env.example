# WORKSTREAM-05-WEB-APPROVAL-UX — TEMPLATE (commit-safe)
# PROTOTYPE — DISPOSABLE — NOT PRODUCTION. Staging/synthetic values only. Lines marked SECRET hold paths or values that must never be logged.
# the one human who runs every lane
MC_OPERATOR=master
MC_WORKSTREAM=WORKSTREAM-05-WEB-APPROVAL-UX
# printed by create_github_repo.sh — git@github.com:<your-username>/mastercoder-p0.git
MC_REPO_URL=__SET_ME__
# the ONE local clone shared by all lanes
MC_REPO_DIR=<abs>/WORKSPACE/repo
# shared workspace: repo/ + worktrees/ for all lanes
MC_WORKSPACE_ROOT=<abs>/WORKSPACE
# this lane folder (its .env is symlinked into every worktree of this lane)
MC_LANE_DIR=<abs>/LANE_05_WEB_APPROVAL_UX
# this lane's A1 works here (branch ws05/coordination)
MC_COORDINATION_WORKTREE=<abs>/WORKSPACE/worktrees/COORD-ws05
# A2 tasks this lane's A1 may run at once (AGENTS.md §3a); all six lanes together default to 15
MC_MAX_PARALLEL_A2=3
# share compiled crates across parallel worktrees (install: cargo install sccache); empty = off
RUSTC_WRAPPER=
# required for sccache to cache; also keeps target/ smaller
CARGO_INCREMENTAL=0
# compiler jobs per A2: on a 24 GB M4 Pro keep 2 so 15 parallel A2s do not exhaust memory; raise to 4-6 when fewer A2s run
CARGO_BUILD_JOBS=2
# upper bound of the shared compile cache on disk
SCCACHE_CACHE_SIZE=30G
# Requested Haiku 5.5; resolve the exact available host model ID, no silent substitution
MC_SUBAGENT_CLAUDE_DEFAULT=haiku-5.5
# reasoning effort for that sub-agent
MC_SUBAGENT_CLAUDE_DEFAULT_EFFORT=max
# Requested Sonnet 5.5; resolve actual host ID and report unavailability
MC_SUBAGENT_CLAUDE_COMPLEX=sonnet-5.5
MC_SUBAGENT_CLAUDE_COMPLEX_EFFORT=high
# OpenAI sub-agent model for routine work; check the exact model id in your Codex version and correct it here
MC_SUBAGENT_OPENAI_DEFAULT=gpt-6-luna
MC_SUBAGENT_OPENAI_DEFAULT_EFFORT=xhigh
# Requested GPT-6.1 Sol for complex work; verify host availability
MC_SUBAGENT_OPENAI_COMPLEX=gpt-6.1-sol
MC_SUBAGENT_OPENAI_COMPLEX_EFFORT=high
# Normally 2–3 helpers per main agent; maximum 3 concurrently, fewer for indivisible tasks
MC_SUBAGENT_MAX_PARALLEL=3
# replace a sub-agent (with a written handover) before its context reaches this
MC_SUBAGENT_CONTEXT_LIMIT_TOKENS=100000
# every worktree addresses the same local containers; never run docker compose down from a task worktree
COMPOSE_PROJECT_NAME=mc-ws05
# fixed
MC_ARCH_ID=MASTERCODER_CONVERGENCE_ARCHITECTURE_SOL_V2_1
# fixed
MC_REGISTRY_SHA256=b516004c690dd86860c263334d9f32f79a6c935ac82f2b801d3117223ed8d787
# printed by bootstrap
MC_ARCH_IMPORT_COMMIT=__SET_ME__
# your GitHub username
MC_GH_USERNAME=__SET_ME__
# created by the W06 lane (W06-T010)
MC_EVIDENCE_STORE_URI=__SET_ME__
# path to your evidence-store credential [SECRET]
MC_EVIDENCE_STORE_CREDENTIAL_PATH=__SET_ME__
# local test DB only — W05 uses mocks only [SECRET]
DATABASE_URL=__SET_ME__
# local docker DB only [SECRET]
POSTGRES_PASSWORD=__SET_ME__
RUST_LOG=info
# ordinary UI dev origin
MC_WEB_ORIGIN_DEV=https://web.mc-local.test:3000
# AA origin — DIFFERENT registrable domain than web
MC_AA_ORIGIN_DEV=https://aa.mc-aa-local.test:3443
# trusted resolution UI origin (pending G-047 triage)
MC_RESOLUTION_ORIGIN_DEV=https://resolve.mc-aa-local.test:3444
# aa-api mock server (built by W05-T013 from W01's I-07 OpenAPI)
MC_AA_API_MOCK_URL=http://localhost:55471
# test IdP port (W05-T007; the W01 P0-09B harness uses it too)
MC_TEST_IDP_PORT=55481
# test IdP admin password — local only [SECRET]
MC_TEST_IDP_ADMIN_PASSWORD=__SET_ME__
# resolution-api mock server (built by W05-T014 from W01's I-08 OpenAPI)
MC_RESOLUTION_API_MOCK_URL=http://localhost:55472
# no telemetry
NEXT_TELEMETRY_DISABLED=1
# browser matrix for CI
MC_PLAYWRIGHT_BROWSERS=chromium,firefox,webkit
